                    "description": "GeeTest v3 gt key"
                  },
                  "challenge": {
                    "type": "string",
                    "description": "GeeTest v3 challenge"
                  },
                  "captchaId": {
                    "type": "string",
                    "description": "GeeTest v4 captcha_id"
                  },
                  "iv": {
                    "type": "string",
                    "description": "AWS WAF iv"
                  },
                  "context": {
                    "type": "string",
                    "description": "AWS WAF context"
                  }
                }
              }
            }
          }
        },
