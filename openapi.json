    }
  ],
  "tags": [
    {
      "name": "M2M Paid Tools (HTTP 402)",
      "description": "Pay-per-request utilities for AI agents protected by L402 (Lightning) and x402 (Base/Solana USDC) with 100/100 SLA completion guarantee."
    },
    {
      "name": "M2M Clearinghouse Orderbook",
