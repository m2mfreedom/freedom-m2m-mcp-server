    },
    {
      "name": "SLA & Telemetry",
      "description": "Real-time verifiable 100/100 task completion and reliability metrics."
    }
  ],
  "components": {
    "securitySchemes": {
      "L402Lightning": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Format: `L402 <macaroon>:<preimage_hex>`. Obtain `<macaroon>` and the BOLT11 invoice from the initial HTTP 402 response, pay the invoice over Bitcoin Lightning to reveal the 32-byte `<preimage_hex>`, and pass both in this header."
      },
      "x402Web3": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Format: `x402 base:<0xTxHash>` (USDC transfer on Base Mainnet to 0x50A9f6256F1d9c20E5Bc76FED6eEdB65C1219D34) or `x402 solana:<TxSignature>` (USDC/SOL transfer on Solana Mainnet to 3vNDgwYpnFyJ16MLkekifB6FNVrFdCCUKmUsgqGd64TZ)."
      }
    },
    "responses": {
      "PaymentRequired402": {
        "description": "HTTP 402 Payment Required — Returns a real-time Bitcoin Lightning BOLT11 invoice + cryptographic Macaroon (L402) and Web3 USDC payment coordinates on Base & Solana (x402).",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "description": "Standard L402 challenge header: `L402 macaroon=\"...\", invoice=\"lnbc...\"`"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Payment Required"
                },
                "protocol": {
                  "type": "string",
                  "example": "L402 (Bitcoin Lightning) + x402 (Base USDC / Solana)"
                },
                "sla_guarantee": {
                  "type": "string",
                  "example": "100/100 Completion Score — Atomic Token Protection (No charge if upstream fails)"
                },
                "challenge": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 402
                    },
                    "costSats": {
                      "type": "integer",
                      "example": 120
                    },
                    "resourcePath": {
                      "type": "string",
                      "example": "/api/v1/router/tools/stealth"
                    },
                    "authenticateHeader": {
                      "type": "string"
                    },
                    "invoice": {
                      "type": "object",
                      "properties": {
                        "paymentHash": {
                          "type": "string"
                        },
                        "amountSats": {
                          "type": "integer"
                        },
                        "bolt11": {
                          "type": "string"
                        },
                        "recipient": {
                          "type": "string",
                          "example": "Lordbryce@coinos.io"
                        }
                      }
                    },
                    "x402": {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string",
                          "example": "1.0"
                        },
                        "amountUSDC": {
                          "type": "number",
                          "example": 0.1131
                        },
                        "acceptedNetworks": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
