        "security": [
          {
            "L402Lightning": []
          },
          {
            "x402Web3": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "namespace"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "store",
                      "recall",
                      "list",
                      "delete"
                    ],
                    "description": "Operation to execute on the persistent memory vault.",
                    "example": "store"
                  },
                  "namespace": {
                    "type": "string",
                    "description": "Unique namespace for your agent or swarm.",
                    "example": "openclaw-research-agent"
                  },
                  "key": {
                    "type": "string",
                    "description": "Key identifier (required for store, recall, delete).",
                    "example": "session_checkpoint_01"
                  },
                  "value": {
                    "type": "object",
                    "description": "JSON object/value to persist when action=\"store\" (max 16 KB).",
                    "example": {
                      "lastProcessedBlock": 21492010,
                      "sentimentScore": 0.84
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memory operation result (`PERSISTED_IN_SQLITE`, recalled JSON value, or key list)."
